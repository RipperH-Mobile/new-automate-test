    {
      "parameters": {
        "jsCode": "let totalTests = 0;\nlet passedTests = 0;\nlet failedTests = 0;\nlet failedDetails = [];\nlet appVersion = \"Unknown\";\n\n// ดึงข้อมูลทุกแถวที่ Spreadsheet ส่งมา\nconst items = $input.all();\n\nfor (const item of items) {\n  const data = item.json;\n  totalTests++;\n  \n  // เก็บข้อมูล Version จากแถวแรกไว้ทำ Report\n  if (totalTests === 1 && data.actual_version) {\n      appVersion = data.actual_version;\n  }\n\n  // เช็กผลลัพธ์ (ทำให้เป็นตัวพิมพ์ใหญ่และตัดช่องว่างทิ้ง เพื่อความชัวร์)\n  const result = (data.actual_result || \"\").trim().toUpperCase();\n\n  if (result === 'PASSED') {\n    passedTests++;\n  } else {\n    failedTests++;\n    // ถ้าไม่ผ่าน ให้เก็บเลขเคสและชื่อเคสไว้\n    failedDetails.push(`- Case ${data.test_case}: ${data.test_description} (Result: ${data.actual_result})`);\n  }\n}\n\n// กำหนดสถานะรวม\nconst status = failedTests === 0 ? \"✅ PASS\" : \"❌ FAIL\";\n\n// ส่งข้อมูลสรุปผลออกไปให้ Node ถัดไป\nreturn [{\n  json: {\n    report: {\n      status: status,\n      total: totalTests,\n      passed: passedTests,\n      failed: failedTests,\n      failed_cases_list: failedDetails.length > 0 ? failedDetails.join('\\n') : \"None\",\n      version_info: appVersion\n    }\n  }\n}];"
      },
